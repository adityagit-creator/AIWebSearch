ggle/input\").rglob(\"model.safetensors.index.json\")\n",").parent)\n","\n","with open(Path(MODEL_PATH) / \"config.json\") as f:\n","    config = json.load(f)\n","\n","print(\"Model:\", config.get(\"model_type\"))\n","print(\"Architecture:\", config.get(\"architectures\"))\n","print(\"Hidden size:\", config.get(\"hidden_size\"))\n","print(\"Layers:\", config.get(\"num_hidden_layers\"))\n","\n","print(\"CUDA available:\", torch.cuda.is_available())\n","\n","if torch.cuda.is_available():\n","    for i in range(torch.cuda.device_count()):\n","        props = torch.cuda.get_device_properties(i)\n","        print(f\"GPU {i}: {props.name}, {props.total_memory / 1024**3:.1f} GiB\")\n","\n","weight_size = sum(\n","    p.stat().st_size\n","    for p in Path(MODEL_PATH).glob(\"*.safetensors\")\n",")\n","\n","print(f\"Model weights: {weight_size / 1024**3:.2f} GiB\")\n","print(\"Model path:\", MODEL_PATH)"]},{"cell_type":"code","execution_count":4,"id":"2ab6a7f9","metadata":{"execution":{"iopub.execute_input":"2026-10-14T11:56:52.734704Z","iopub.status.busy":"2026-10-14T11:56:52.733842Z","iopub.status.idle":"2026-10-14T11:57:33.427866Z","shell.execute_reply":"2026-10-14T11:57:33.427038Z"},"papermill":{"duration":40.699033,"end_time":"2026-10-14T11:57:33.429464+00:00","exception":false,"start_time":"2026-10-14T11:56:52.730431+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"6c5a974aa38f4223ae47eac8bd18a143","version_major":2,"version_minor":0},"text/plain":["Loading weights:   0%|          | 0/398 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Qwen3-4B loaded successfully!\n","GPU memory allocated: 7.49 GiB\n"]}],"source":["import torch\n","from transformers import AutoTokenizer, AutoModelForCausalLM\n","\n","MODEL_PATH = \"/kaggle/input/models/qwen-lm/qwen-3/transformers/4b/1\"\n","\n","tokenizer = AutoTokenizer.from_pretrained(\n","    MODEL_PATH,\n","    local_files_only=True\n",")\n","\n","model = AutoModelForCausalLM.from_pretrained(\n","    MODEL_PATH,\n","    dtype=torch.float16,\n","    device_map={\"\": \"cuda:0\"},\n","    local_files_only=True,\n","    low_cpu_mem_usage=True\n",")\n","\n","model.eval()\n","\n","print(\"Qwen3-4B loaded successfully!\")\n","print(\n","    \"GPU memory allocated:\",\n","    round(torch.cuda.memory_allocated(0) / 1024**3, 2),\n","    \"GiB\"\n",")"]},{"cell_type":"code","execution_count":5,"id":"59265dad","metadata":{"execution":{"iopub.execute_input":"2026-10-14T11:57:33.43716Z","iopub.status.busy":"2026-10-14T11:57:33.436443Z","iopub.status.idle":"2026-10-14T11:57:33.443013Z","shell.execute_reply":"2026-10-14T11:57:33.442237Z"},"papermill":{"duration":0.012244,"end_time":"2026-10-14T11:57:33.444517+00:00","exception":false,"start_time":"2026-10-14T11:57:33.432273+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import torch\n","\n","def ask_qwen(\n","    prompt,\n","    max_tokens=512,\n","    temperature=0.3,\n","    top_p=0.9\n","):\n","    messages = [\n","        {\"role\": \"user\", \"content\": prompt}\n","    ]\n","\n","    inputs = tokenizer.apply_chat_template(\n","        messages,\n","        tokenize=True,\n","        add_generation_prompt=True,\n","        enable_thinking=False,\n","        return_tensors=\"pt\",\n","        return_dict=True\n","    )\n","\n","    inputs = {\n","        key: value.to(\"cuda:0\")\n","        for key, value in inputs.items()\n","    }\n","\n","    with torch.inference_mode():\n","        output = model.generate(\n","            **inputs,\n","            max_new_tokens=max_tokens,\n","            do_sample=True,\n","            temperature=temperature,\n","            top_p=top_p,\n","            pad_token_id=tokenizer.eos_token_id\n","        )\n","\n","    input_length = inputs[\"input_ids\"].shape[1]\n","\n","    result = tokenizer.decode(\n","        output[0][input_length:],\n","        skip_special_tokens=True\n","    )\n","\n","    return result.strip()"]},{"cell_type":"code","execution_count":6,"id":"ff383b72","metadata":{"execution":{"iopub.execute_input":"2026-10-14T11:57:33.450811Z","iopub.status.busy":"2026-10-14T11:57:33.450517Z","iopub.status.idle":"2026-10-14T11:57:35.264043Z","shell.execute_reply":"2026-10-14T11:57:35.262954Z"},"papermill":{"duration":1.818472,"end_time":"2026-10-14T11:57:35.265587+00:00","exception":false,"start_time":"2026-10-14T11:57:33.447115+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["LocalLead AI ready\n"]}],"source":["print(\n","    ask_qwen(\n","        \"Reply with exactly: LocalLead AI ready\",\n","        max_tokens=40\n","    )\n",")"]},{"cell_type":"code","execution_count":7,"id":"7dad7e30","metadata":{"execution":{"iopub.execute_input":"2026-10-14T11:57:35.272383Z","iopub.status.busy":"2026-10-14T11:57:35.271688Z","iopub.status.idle":"2026-10-14T11:57:39.888827Z","shell.execute_reply":"2026-10-14T11:57:39.887797Z"},"papermill":{"duration":4.622187,"end_time":"2026-10-14T11:57:39.890504+00:00","exception":false,"start_time":"2026-10-14T11:57:35.268317+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["{\n","  \"company_name\": \"ABC Dental Clinic\",\n","  \"business_category\": \"Healthcare Services\",\n","  \"main_services\": [\"Dental checkups\", \"Teeth cleaning\", \"Root canal treatment\", \"Appointment booking by phone\"],\n","  \"software_automation_opportunities\": [\n","    \"Automated appointment scheduling system to streamline booking process\",\n","    \"Patient management software to track medical history and reminders\"\n","  ]\n","}\n"]}],"source":["sample_business = \"\"\"\n","Company: ABC Dental Clinic\n","\n","Services:\n","- Dental checkups\n","- Teeth cleaning\n","- Root canal treatment\n","- Appointment booking by phone\n","\n","Website:\n","The clinic offers dental consultations and appointments.\n","Patients currently book by calling the reception desk.\n","\"\"\"\n","\n","prompt = f\"\"\"\n","You are a business research assistant.\n","\n","Analyze this business and identify:\n","1. Company name\n","2. Business category\n","3. Main services\n","4. Two potential software automation opportunities\n","\n","Return concise JSON only.\n","\n","Business information:\n","{sample_business}\n","\"\"\"\n","\n","print(ask_qwen(prompt, 300))"]},{"cell_type":"code","execution_count":8,"id":"19a8ceed","metadata":{"execution":{"iopub.execute_input":"2026-10-14T11:57:39.897493Z","iopub.status.busy":"2026-10-14T11:57:39.897067Z","iopub.status.idle":"2026-10-14T11:57:40.154862Z","shell.execute_reply":"2026-10-14T11:57:40.153983Z"},"papermill":{"duration":0.263435,"end_time":"2026-10-14T11:57:40.156804+00:00","exception":false,"start_time":"2026-10-14T11:57:39.893369+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["\n","import requests\n","import json\n","import time\n","from pathlib import Path\n","from bs4 import BeautifulSoup\n","from urllib.parse import urljoin, urlparse, urldefrag\n","from collections import deque\n","\n","HEADERS = {\n","    \"User-Agent\": \"LocalLeadAI/1.0 (business research)\"\n","}\n","\n","SKIP_EXTENSIONS = (\n","    \".pdf\", \".jpg\", \".png\", \".jpeg\", \".zip\",\n","    \".svg\", \".webp\", \".mp4\", \".css\", \".js\"\n",")\n","\n","def crawl_website(start_url, max_pages=10):\n","    start_url = start_url.rstrip(\"/\")\n","    origin = urlparse(start_url)\n","    root_domain = origin.hostname.removeprefix(\"www.\")\n","\n","    queue = deque([start_url])\n","    visited = set()\n","    pages = []\n","\n","    session = requests.Session()\n","    session.headers.update(HEADERS)\n","\n","    while queue and len(pages) < max_pages:\n","        url = queue.popleft()\n","        url, _ = urldefrag(url)\n","\n","        if url in visited:\n","            continue\n","\n","        visited.add(url)\n","\n","        try:\n","            response = session.get(url, timeout=15)\n","            response.raise_for_status()\n","\n","            final_url = response.url\n","            hostname = urlparse(final_url).hostname or \"\"\n","\n","            if hostname.removeprefix(\"www.\") != root_domain:\n","                continue\n","\n","            if \"text/html\" not in response.headers.get(\n","                \"Content-Type\", \"\"\n","            ).lower():\n","                continue\n","\n","            soup = BeautifulSoup(response.text, \"html.parser\")\n","\n","            for a in soup.find_all(\"a\", href=True):\n","                link = urljoin(final_url, a[\"href\"])\n","                link, _ = urldefrag(link)\n","                parsed = urlparse(link)\n","\n","                if parsed.scheme not in (\"http\", \"https\"):\n","                    continue\n","\n","                link_host = parsed.hostname or \"\"\n","                if link_host.removeprefix(\"www.\") != root_domain:\n","                    continue\n","\n","                if parsed.path.lower().endswith(SKIP_EXTENSIONS):\n","                    continue\n","\n","                if link not in visited and link not in queue:\n","                    queue.append(link)\n","\n","            # Preserve header, nav and footer text;\n","            # remove scripts, styles and hidden templates.\n","            for tag in soup([\n","                \"script\", \"style\", \"noscript\",\n","                \"template\", \"svg\"\n","            ]):\n","                tag.decompose()\n","\n","            title = (\n","                soup.title.get_text(\" \", strip=True)\n","                if soup.title else \"\"\n","            )\n","\n","            clean_text = soup.get_text(\" \", strip=True)\n","\n","            pages.append({\n","                \"url\": final_url,\n","                \"title\": title,\n","                \"content\": clean_text[:12000]\n","            })\n","\n","            print(f\"[{len(pages)}] {final_url}\")\n","            time.sleep(0.5)\n","\n","        except requests.RequestException as e:\n","            print(f\"Skipped {url}: {e}\")\n","\n","    return pages\n"]},{"cell_type":"code","execution_count":9,"id":"65c44a30","metadata":{"execution":{"iopub.execute_input":"2026-10-14T11:57:40.164579Z","iopub.status.busy":"2026-10-14T11:57:40.163712Z","iopub.status.idle":"2026-10-14T11:58:11.729331Z","shell.execute_reply":"2026-10-14T11:58:11.728492Z"},"papermill":{"duration":31.570908,"end_time":"2026-10-14T11:58:11.73088+00:00","exception":false,"start_time":"2026-10-14T11:57:40.159972+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[1] https://krispcall.com/\n","[2] https://krispcall.com/downloads/\n","[3] https://krispcall.com/\n","[4] https://krispcall.com/feature/\n","[5] https://krispcall.com/whats-new/\n","[6] https://krispcall.com/feature/call-routing/\n","[7] https://krispcall.com/feature/phone-tree/\n","[8] https://krispcall.com/feature/call-queuing/\n","[9] https://krispcall.com/feature/call-recording/\n","[10] https://krispcall.com/feature/call-analytics/\n","Pages extracted: 10\n","Saved: /kaggle/working/locallead/website_content.json\n"]}],"source":["website_url = \"https://krispcall.com\" \n","\n","pages = crawl_website(website_url, max_pages=10)\n","\n","output_dir = Path(\"/kaggle/working/locallead\")\n","output_dir.mkdir(exist_ok=True)\n","\n","(output_dir / \"website_content.json\").write_text(\n","    json.dumps(pages, indent=2, ensure_ascii=False),\n","    encoding=\"utf-8\"\n",")\n","\n","print(\"Pages extracted:\", len(pages))\n","print(\"Saved:\", output_dir / \"website_content.json\")"]},{"cell_type":"code","execution_count":10,"id":"06d070d4","metadata":{"execution":{"iopub.execute_input":"2026-10-14T11:58:11.738328Z","iopub.status.busy":"2026-10-14T11:58:11.738092Z","iopub.status.idle":"2026-10-14T11:59:55.619386Z","shell.execute_reply":"2026-10-14T11:59:55.618687Z"},"papermill":{"duration":103.890812,"end_time":"2026-10-14T11:59:55.624836+00:00","exception":false,"start_time":"2026-10-14T11:58:11.734024+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","SOURCE: https://krispcall.com/\n","**Business Identity**: KrispCall is an AI-powered communication platform designed for growing businesses.  \n","**Products and Services**: It offers a phone system with features like call routing, phone tree (IVR), call queue, call recording, and analytics. Additional services include outbound dialing, AI tools like AI Copilot, and unified call management.  \n","**Target Customers**: Businesses looking to enhance communication efficiency and customer engagement.  \n","**Booking/Contact Methods**: Users can claim a free trial, download the app, or book a demo.  \n","**Existing Software/Digital Features**: AI Copilot, call summary, transcription, and AI reply tools are integrated.  \n","**Operational Details**: The platform supports global calling, custom caller ID, and integrates with various systems. It emphasizes scalability and productivity for teams. (199 words)\n","\n","SOURCE: https://krispcall.com/downloads/\n","KrispCall is a business phone system offering cloud-based phone services, including call routing, voicemail, messaging, and integrations. The platform provides features like AI-powered tools, call recording, analytics, and unified communication. Target customers include small to medium-sized businesses seeking scalable phone solutions. Users can download the app on web, iOS, and Android, with access to a free 2-month trial. Booking a demo or exploring features is available through the website. The system includes AI Copilot for call summaries, transcriptions, and response drafting. It also offers call analytics, outbound dialing tools, and global calling capabilities. KrispCall supports 2FA, integrations, and unified call management. The service is designed for businesses aiming to improve communication efficiency and customer engagement.\n","\n","SOURCE: https://krispcall.com/\n","**Business Identity**: KrispCall is an AI-powered communication platform designed for growing businesses.  \n","**Products and Services**: It offers a phone system with features like call routing, phone tree (IVR), call queue, call recording, and analytics. Additional services include outbound dialing, AI tools like AI Copilot, and voicemail management.  \n","**Target Customers**: Businesses looking to enhance communication efficiency and customer engagement.  \n","**Booking/Contact Methods**: Users can claim a free trial, download the app, or book a demo.  \n","**Existing Software/Digital Features**: The platform includes AI-driven tools such as call summaries, transcription, and AI reply.  \n","**Operational Details**: KrispCall provides a flexible phone system that scales with the business, with integration options and global calling capabilities.  \n","(197 words)\n","\n","SOURCE: https://krispcall.com/feature/\n","KrispCall is an AI-powered communication platform offering VoIP features. It provides a comprehensive phone system with tools like call routing, phone tree (IVR), call queue, call recording, and analytics. The platform also includes messaging, phone numbers, integrations, 2FA, and a unified callbox for managing calls, texts, voicemail, and contacts. Target customers include businesses seeking efficient communication solutions. Users can book a demo, explore features, or download the platform. KrispCall supports outbound dialing with a power dialer, click-to-dial, voicemail drop, and custom caller ID. It enables global calling and offers AI features like AI Copilot, call summary, transcription, and AI reply. The platform includes call notes, logs, and history for improved customer interaction. KrispCall is designed for businesses looking to enhance productivity and customer engagement through advanced communication tools. (199 words)\n","\n","SOURCE: https://krispcall.com/whats-new/\n","KrispCall is a business phone system offering features like call routing, IVR, call queue, recording, analytics, and unified call management. It targets businesses seeking efficient communication solutions, including sales, customer service, and support teams. Customers can book a demo, download the app, or log in to access features. The platform includes AI tools such as AI Copilot, call summary, transcription, and AI reply for enhanced productivity. Digital features include call recording, analytics, and integration with CRM systems. KrispCall provides a flexible phone system with options for outbound dialing, power dialer, and global calling. Users can manage calls, texts, voicemail, and contacts in one place. The service offers a free trial of up to two months. Operational details include 2FA, integrations, and support for multiple devices and international markets. The website highlights updates and new features aimed at improving call efficiency and customer engagement.\n","\n","SOURCE: https://krispcall.com/feature/call-routing/\n","KrispCall is a business phone system offering call routing, AI tools, and communication features to enhance customer interactions. The business identity focuses on providing a flexible, scalable phone system with advanced call management capabilities. Products and services include call routing, phone tree (IVR), call queue, call recording, analytics, and AI-driven features like AI Copilot and call transcription. Target customers are businesses seeking to improve call efficiency, customer service, and team productivity. Booking, ordering, or contacting can be done through the website, with a free 2-month offer available. Existing software includes call routing, unified callbox, and AI tools. Operational details highlight features like call transfer, forwarding, and voicemail management. The platform supports outbound dialing, global calling, and integration with CRM systems. KrispCall aims to help businesses reach more prospects and improve communication quality. (199 words)\n","\n","SOURCE: https://krispcall.com/feature/phone-tree/\n","KrispCall is a business phone system offering IVR (Interactive Voice Response) phone tree solutions, outbound dialing, AI tools, and messaging services. The platform enables businesses to route calls efficiently, record conversations, and analyze call data. Target customers include small to medium-sized businesses seeking scalable communication solutions. Booking and ordering are handled through the KrispCall website, with a free 2-month trial available. The system includes features like call routing, call recording, analytics, and unified call management. Existing digital features include AI Copilot for call summaries and transcriptions, as well as AI-driven response drafting. Operational details highlight support for global calling, custom caller ID, and integration with CRM systems. The platform aims to enhance customer engagement and operational efficiency through streamlined communication tools. (199 words)\n","\n","SOURCE: https://krispcall.com/feature/call-queuing/\n","KrispCall is a business phone system offering call management, outbound dialing, AI tools, and messaging features. It provides a flexible phone system with call routing, call queues, call recording, analytics, and unified callbox for managing calls, texts, voicemail, and contacts. Target customers include businesses seeking efficient communication solutions. Booking and ordering can be done via the website, with a demo available. The platform includes features like AI Copilot, call summary, transcription, and AI reply. Existing software includes call routing, phone tree (IVR), call transfer, and voicemail. Operational details include global calling, custom caller ID, and integration with CRMs. Users can set up a scalable phone system tailored to their business needs. KrispCall offers a 2-month free trial. (199 words)\n","\n","SOURCE: https://krispcall.com/feature/call-recording/\n","KrispCall is a business call recording and phone system software designed to enhance communication efficiency and quality. The platform offers features such as call routing, phone trees, call queues, call recording, call analytics, and unified call management. It caters to businesses seeking to improve customer service, compliance, and team performance. Target customers include businesses of all sizes that need reliable phone systems and call recording capabilities.\n","\n","Users can book a demo, download the software, or log in to access features. The platform supports outbound dialing, AI-driven tools like AI Copilot, call summaries, and transcription. Call recording is a key feature for quality assurance and review. KrispCall also provides global calling options and integrates with various business tools.\n","\n","The software is available for purchase with a free trial of up to two months. It offers a flexible phone system that can scale with the business. Contact methods include the website, demo booking, and support resources. Operational details include 2FA, integrations, and customer support.\n","\n","SOURCE: https://krispcall.com/feature/call-analytics/\n","KrispCall is a business phone system offering cloud-based communication solutions. Its products include a phone system with features like call routing, phone tree (IVR), call queue, call recording, and call analytics. It also provides AI & Intelligence tools such as AI Copilot, call summary, and transcription. Additional services include outbound dialing, messaging, phone numbers, and integrations. Target customers are businesses seeking scalable, efficient communication tools. Booking and ordering are handled through the website, with a demo available. Existing software includes call analytics, unified callbox, and voicemail. Digital features include AI-driven insights, call notes, and call logs. Operational details include a free 2-month trial, 2FA, and global calling capabilities. The platform supports team collaboration and customer engagement through customizable features.\n"]}],"source":["def summarize_website(pages):\n","    summaries = []\n","\n","    for page in pages:\n","        prompt = f\"\"\"\n","Summarize this business webpage accurately.\n","\n","Include:\n","- Business identity\n","- Products and services\n","- Target customers\n","- Booking, ordering, or contact methods\n","- Existing software or digital features\n","- Relevant operational details\n","\n","Rules:\n","- Use only the supplied content.\n","- Do not invent information.\n","- Keep the summary under 200 words.\n","\n","Source: {page['url']}\n","\n","Content:\n","{page['content'][:6000]}\n","\"\"\"\n","        summary = ask_qwen(prompt, max_tokens=300)\n","\n","        summaries.append({\n","            \"url\": page[\"url\"],\n","            \"summary\": summary\n","        })\n","\n","    return summaries\n","\n","\n","summaries = summarize_website(pages)\n","\n","(output_dir / \"website_summaries.json\").write_text(\n","    json.dumps(summaries, indent=2, ensure_ascii=False),\n","    encoding=\"utf-8\"\n",")\n","\n","for item in summaries:\n","    print(\"\\nSOURCE:\", item[\"url\"])\n","    print(item[\"summary\"])"]},{"cell_type":"code","execution_count":11,"id":"294ed3ef","metadata":{"execution":{"iopub.execute_input":"2026-10-14T11:59:55.632581Z","iopub.status.busy":"2026-10-14T11:59:55.631875Z","iopub.status.idle":"2026-10-14T12:00:37.354093Z","shell.execute_reply":"2026-10-14T12:00:37.353262Z"},"papermill":{"duration":41.731305,"end_time":"2026-10-14T12:00:37.359271+00:00","exception":false,"start_time":"2026-10-14T11:59:55.627966+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["{\n","  \"company_name\": \"KrispCall\",\n","  \"business_category\": \"AI-powered communication platform\",\n","  \"business_summary\": \"KrispCall is an AI-powered communication platform designed for growing businesses, offering a phone system with features like call routing, phone tree (IVR), call queue, call recording, and analytics. It also includes AI tools like AI Copilot, unified call management, and outbound dialing. The platform supports global calling, custom caller ID, and integrates with various systems, emphasizing scalability and productivity for teams.\",\n","  \"target_customers\": [\"Businesses looking to enhance communication efficiency and customer engagement\"],\n","  \"existing_digital_features\": [\"AI Copilot\", \"call summary\", \"transcription\", \"AI reply\", \"call recording\", \"analytics\", \"unified call management\", \"outbound dialing\", \"global calling\", \"2FA\", \"CRM integrations\"],\n","  \"potential_software_needs\": [\n","    {\n","      \"solution\": \"AI-powered call analytics tools\",\n","      \"reason\": \"KrispCall already provides call analytics, but additional AI-driven insights could enhance customer engagement and team performance.\",\n","      \"supporting_source_url\": \"https://krispcall.com/feature/call-analytics/\",\n","      \"confidence\": \"medium\"\n","    },\n","    {\n","      \"solution\": \"Advanced CRM integration tools\",\n","      \"reason\": \"KrispCall supports CRM integrations, but more advanced tools could improve customer interaction and sales efficiency.\",\n","      \"supporting_source_url\": \"https://krispcall.com/feature/call-analytics/\",\n","      \"confidence\": \"medium\"\n","    },\n","    {\n","      \"solution\": \"Unified communication platform with multi-channel support\",\n","      \"reason\": \"KrispCall offers unified call management, but expanding to support more communication channels could enhance customer engagement.\",\n","      \"supporting_source_url\": \"https://krispcall.com/feature/call-routing/\",\n","      \"confidence\": \"medium\"\n","    }\n","  ],\n","  \"suggested_services\": [\"AI-powered call analytics tools\", \"Advanced CRM integration tools\", \"Unified communication platform with multi-channel support\"],\n","  \"lead_priority\": \"medium\"\n","}\n"]}],"source":["def generate_lead_report(summaries):\n","    combined = \"\\n\\n\".join(\n","        f\"Source: {item['url']}\\n{item['summary']}\"\n","        for item in summaries\n","    )\n","\n","    prompt = f\"\"\"\n","You are an AI business research analyst.\n","\n","Review the business information below.\n","\n","Return valid JSON with exactly these fields:\n","\n","{{\n","  \"company_name\": \"\",\n","  \"business_category\": \"\",\n","  \"business_summary\": \"\",\n","  \"target_customers\": [],\n","  \"existing_digital_features\": [],\n","  \"potential_software_needs\": [\n","    {{\n","      \"solution\": \"\",\n","      \"reason\": \"\",\n","      \"supporting_source_url\": \"\",\n","      \"confidence\": \"low/medium/high\"\n","    }}\n","  ],\n","  \"suggested_services\": [],\n","  \"lead_priority\": \"low/medium/high\"\n","}}\n","\n","Rules:\n","1. Only use facts from the supplied summaries.\n","2. Recommend at most 3 realistic software solutions.\n","3. Distinguish suggestions from confirmed business needs.\n","4. Never invent revenue, contacts, or business problems.\n","5. Use source URLs to support recommendations.\n","6. Return JSON only.\n","\n","Business information:\n","{combined[:12000]}\n","\"\"\"\n","\n","    return ask_qwen(prompt, max_tokens=900)\n","\n","\n","lead_report = generate_lead_report(summaries)\n","\n","print(lead_report)"]},{"cell_type":"code","execution_count":12,"id":"5e4b2ee1","metadata":{"execution":{"iopub.execute_input":"2026-10-14T12:00:37.36722Z","iopub.status.busy":"2026-10-14T12:00:37.366598Z","iopub.status.idle":"2026-10-14T12:00:37.371303Z","shell.execute_reply":"2026-10-14T12:00:37.370632Z"},"papermill":{"duration":0.010253,"end_time":"2026-10-14T12:00:37.37273+00:00","exception":false,"start_time":"2026-10-14T12:00:37.362477+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Lead report saved successfully\n"]}],"source":["(output_dir / \"lead_report.json\").write_text(\n","    lead_report,\n","    encoding=\"utf-8\"\n",")\n","\n","print(\"Lead report saved successfully\")"]},{"cell_type":"code","execution_count":13,"id":"7c79cc3e","metadata":{"execution":{"iopub.execute_input":"2026-10-14T12:00:37.381014Z","iopub.status.busy":"2026-10-14T12:00:37.380324Z","iopub.status.idle":"2026-10-14T12:00:37.386874Z","shell.execute_reply":"2026-10-14T12:00:37.386167Z"},"papermill":{"duration":0.012241,"end_time":"2026-10-14T12:00:37.388333+00:00","exception":false,"start_time":"2026-10-14T12:00:37.376092+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import json\n","from pathlib import Path\n","from urllib.parse import urlparse\n","\n","def analyze_website(url, max_pages=10):\n","    print(\"Crawling website...\")\n","    pages = crawl_website(url, max_pages=max_pages)\n","\n","    if not pages:\n","        return {\"error\": \"No website content extracted\"}\n","\n","    domain = urlparse(url).hostname.replace(\".\", \"_\")\n","    output_dir = Path(\"/kaggle/working/locallead\") / domain\n","    output_dir.mkdir(parents=True, exist_ok=True)\n","\n","    (output_dir / \"website_content.json\").write_text(\n","        json.dumps(pages, indent=2, ensure_ascii=False),\n","        encoding=\"utf-8\"\n","    )\n","\n","    print(\"Summarizing website...\")\n","    summaries = summarize_website(pages)\n","\n","    (output_dir / \"website_summaries.json\").write_text(\n","        json.dumps(summaries, indent=2, ensure_ascii=False),\n","        encoding=\"utf-8\"\n","    )\n","\n","    print(\"Generating lead report...\")\n","    report_text = generate_lead_report(summaries)\n","\n","    try:\n","        result = json.loads(report_text)\n","    except json.JSONDecodeError:\n","        result = {\n","            \"error\": \"Model returned invalid JSON\",\n","            \"raw_response\": report_text\n","        }\n","\n","    (output_dir / \"lead_report.json\").write_text(\n","        json.dumps(result, indent=2, ensure_ascii=False),\n","        encoding=\"utf-8\"\n","    )\n","\n","    print(\"Saved results to:\", output_dir)\n","\n","    return result"]},{"cell_type":"code","execution_count":14,"id":"ce4b7ab4","metadata":{"execution":{"iopub.execute_input":"2026-10-14T12:00:37.395581Z","iopub.status.busy":"2026-10-14T12:00:37.395133Z","iopub.status.idle":"2026-10-14T12:01:51.565916Z","shell.execute_reply":"2026-10-14T12:01:51.565013Z"},"papermill":{"duration":74.176342,"end_time":"2026-10-14T12:01:51.567701+00:00","exception":false,"start_time":"2026-10-14T12:00:37.391359+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Crawling website...\n","[1] https://cheeti.tech/index\n","[2] https://cheeti.tech/index\n","[3] https://cheeti.tech/appointment\n","[4] https://cheeti.tech/Authentication\n","Summarizing website...\n","Generating lead report...\n","Saved results to: /kaggle/working/locallead/cheeti_tech\n","{\n","  \"company_name\": \"Cheeti Cheeti Technologies\",\n","  \"business_category\": \"No-code web and mobile application development\",\n","  \"business_summary\": \"Cheeti Cheeti Technologies is an India-based technology studio that offers no-code web and mobile application development services. They provide custom software, workflow automation, cloud-based operations, and data-driven applications. Key offerings include the NEMO engine, SF StampFinder, NE NEMO, SH Sherpa, and CB CloudBiz Center.\",\n","  \"target_customers\": [\n","    \"Businesses\",\n","    \"Non-profits\",\n","    \"Investors\"\n","  ],\n","  \"existing_digital_features\": [\n","    \"No-code application builder\",\n","    \"AI-assisted code generation\",\n","    \"Metadata-driven systems\",\n","    \"Task tracker\",\n","    \"Dashboard\"\n","  ],\n","  \"potential_software_needs\": [\n","    {\n","      \"solution\": \"Appointment scheduling software\",\n","      \"reason\": \"The business offers online appointment scheduling, but the website is currently unstable and not fully functional.\",\n","      \"supporting_source_url\": \"https://cheeti.tech/appointment\",\n","      \"confidence\": \"medium\"\n","    },\n","    {\n","      \"solution\": \"Customer relationship management (CRM) system\",\n","      \"reason\": \"The business serves businesses, non-profits, and investors, which may require a CRM system to manage client interactions and data.\",\n","      \"supporting_source_url\": \"https://cheeti.tech/index\",\n","      \"confidence\": \"medium\"\n","    },\n","    {\n","      \"solution\": \"Secure authentication system\",\n","      \"reason\": \"The authentication page is currently unable to function, indicating a need for a secure and reliable authentication system.\",\n","      \"supporting_source_url\": \"https://cheeti.tech/Authentication\",\n","      \"confidence\": \"high\"\n","    }\n","  ],\n","  \"suggested_services\": [\n","    \"Appointment scheduling software\",\n","    \"CRM system\",\n","    \"Secure authentication system\"\n","  ],\n","  \"lead_priority\": \"medium\"\n","}\n"]}],"source":["url = \"https://cheeti.tech\"\n","\n","result = analyze_website(url)\n","\n","print(json.dumps(result, indent=2, ensure_ascii=False))"]},{"cell_type":"code","execution_count":15,"id":"067ddd71","metadata":{"execution":{"iopub.execute_input":"2026-10-14T12:01:51.576586Z","iopub.status.busy":"2026-10-14T12:01:51.575775Z","iopub.status.idle":"2026-10-14T12:04:50.067857Z","shell.execute_reply":"2026-10-14T12:04:50.066981Z"},"papermill":{"duration":178.501406,"end_time":"2026-10-14T12:04:50.07272+00:00","exception":false,"start_time":"2026-10-14T12:01:51.571314+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Crawling website...\n","[1] https://krispcall.com/\n","[2] https://krispcall.com/downloads/\n","[3] https://krispcall.com/\n","[4] https://krispcall.com/feature/\n","[5] https://krispcall.com/whats-new/\n","[6] https://krispcall.com/feature/call-routing/\n","[7] https://krispcall.com/feature/phone-tree/\n","[8] https://krispcall.com/feature/call-queuing/\n","[9] https://krispcall.com/feature/call-recording/\n","[10] https://krispcall.com/feature/call-analytics/\n","Summarizing website...\n","Generating lead report...\n","Saved results to: /kaggle/working/locallead/krispcall_com\n","{'company_name': 'KrispCall', 'business_category': 'AI-powered communication platform', 'business_summary': 'KrispCall is an AI-powered communication platform designed for growing businesses, offering a comprehensive phone system with features like call routing, phone tree (IVR), call queue, call recording, and analytics. It also includes AI tools such as AI Copilot for call summaries, transcriptions, and response drafting, along with unified call management and global calling capabilities.', 'target_customers': ['Businesses seeking to enhance communication efficiency and customer engagement', 'Small to medium-sized businesses seeking scalable communication solutions', 'Businesses in sales, customer service, and customer support looking for efficient communication tools'], 'existing_digital_features': ['AI Copilot for call summaries, transcriptions, and response drafting', 'Call routing, phone tree (IVR), call queue, and call recording', 'Call analytics, unified call management, and global calling capabilities', '2FA, call forwarding, and custom caller ID'], 'potential_software_needs': [{'solution': 'AI Copilot Integration', 'reason': 'KrispCall already has AI Copilot for call summaries, transcriptions, and response drafting, but further integration with CRM systems could enhance customer interaction and operational efficiency.', 'supporting_source_url': 'https://krispcall.com/feature/', 'confidence': 'high'}, {'solution': 'Call Analytics Dashboard', 'reason': 'KrispCall provides call analytics, but a more detailed dashboard could help track team performance and improve call management.', 'supporting_source_url': 'https://krispcall.com/feature/call-analytics/', 'confidence': 'medium'}, {'solution': 'Unified Communication Platform', 'reason': 'KrispCall offers unified call management, but a more integrated platform with messaging, voicemail, and contact management could enhance productivity.', 'supporting_source_url': 'https://krispcall.com/feature/', 'confidence': 'high'}], 'suggested_services': ['CRM integration', 'Advanced call analytics tools', 'Unified communication platform with messaging and voicemail'], 'lead_priority': 'high'}\n"]}],"source":["url = \"https://krispcall.com\"\n","\n","result = analyze_website(url)\n","\n","print(result)"]},{"cell_type":"code","execution_count":16,"id":"c337c0bf","metadata":{"execution":{"iopub.execute_input":"2026-10-14T12:04:50.082006Z","iopub.status.busy":"2026-10-14T12:04:50.081303Z","iopub.status.idle":"2026-10-14T12:04:50.466704Z","shell.execute_reply":"2026-10-14T12:04:50.46597Z"},"papermill":{"duration":0.3916,"end_time":"2026-10-14T12:04:50.468183+00:00","exception":false,"start_time":"2026-10-14T12:04:50.076583+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Unused GPU cache cleared!\n"]}],"source":["import torch\n","import gc\n","\n","# Remove old inference variables\n","for name in [\"inputs\", \"outputs\", \"output\"]:\n","    if name in globals():\n","        del globals()[name]\n","\n","# Clear any stored model KV cache\n","if hasattr(model, \"_cache\"):\n","    model._cache = None\n","\n","# Run Python garbage collection\n","gc.collect()\n","\n","# Release unused PyTorch GPU allocations\n","torch.cuda.empty_cache()\n","torch.cuda.ipc_collect()\n","\n","print(\"Unused GPU cache cleared!\")"]},{"cell_type":"code","execution_count":17,"id":"5066ba85","metadata":{"execution":{"iopub.execute_input":"2026-10-14T12:04:50.477701Z","iopub.status.busy":"2026-10-14T12:04:50.477468Z","iopub.status.idle":"2026-10-14T12:04:50.482718Z","shell.exec